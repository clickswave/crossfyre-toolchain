# Synthetic: A Laravel application, which sets its XSRF and session cookies on every page.
HTTP/1.1 200 OK
content-type: text/html; charset=UTF-8
cache-control: no-cache, private
date: Fri, 20 Nov 2026 06:00:00 GMT
set-cookie: XSRF-TOKEN=
set-cookie: laravel_session=

<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Laravel</title>
</head>
<body>
<div class="relative flex items-top justify-center"></div>
</body>
</html>
