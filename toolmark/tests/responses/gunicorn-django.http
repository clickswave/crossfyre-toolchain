# Synthetic: A Django site on gunicorn 20, which still put its version in Server.
HTTP/1.1 200 OK
server: gunicorn/20.1.0
date: Fri, 20 Nov 2026 06:00:00 GMT
content-type: text/html; charset=utf-8
x-frame-options: DENY
vary: Cookie
set-cookie: csrftoken=
set-cookie: django_language=

<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Log in</title>
</head>
<body>
<form method="post"><input type="hidden" name="csrfmiddlewaretoken" value=""></form>
</body>
</html>
