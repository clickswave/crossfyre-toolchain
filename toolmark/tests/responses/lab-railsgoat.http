      border-color: transparent;
      color: white;
    }

    .btn-outline-primary {
      border: 2px solid var(--rg-primary);
      color: var(--rg-primary);
      background: white;
    }

    .btn-outline-primary:hover {
      background: var(--rg-primary);
      color: white;
