      line-height: 1;
      display: inline-block;
      min-width: 1.75rem;
      text-align: center;
    }

    .rg-header .row {
      margin-left: 0;
      margin-right: 0;
    }

    /* Fix alignment of button_to forms in header */
    .rg-header form {
      margin: 0;
