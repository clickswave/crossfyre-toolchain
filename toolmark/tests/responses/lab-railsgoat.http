      display: inline-block;
    }

    /* Modern Sidebar */
    .rg-sidebar {
      position: fixed;
      top: var(--rg-header-height);
      left: 0;
      bottom: 0;
      width: var(--rg-sidebar-width);
      background: var(--rg-dark);
      color: white;
      overflow-y: auto;
      transition: transform 0.3s ease;
      box-shadow: 2px 0 12px rgba(0,0,0,0.1);
    }

    .rg-sidebar-nav {
      list-style: none;
      padding: 1rem 0;
      margin: 0;
